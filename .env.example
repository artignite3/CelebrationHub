# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.
# The site works without any of them: the wish wall stays hidden and the form says it is not connected.

# Wish storage: Upstash Redis (Vercel Marketplace > Upstash for Redis sets the KV_* pair for you)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or Upstash's own names:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Guest photos: Vercel Blob (Storage > Create > Blob sets this for you)
BLOB_READ_WRITE_TOKEN=

# Your key for /admin, where wishes are approved. At least 24 characters, e.g. `openssl rand -base64 32`.
# Unset or shorter disables the admin entirely.
ADMIN_TOKEN=

# Optional: salt for hashing visitor IPs in rate limits (defaults to the Redis token)
RATE_LIMIT_SALT=

# Optional: canonical URL for share previews (Vercel provides one automatically)
NEXT_PUBLIC_SITE_URL=
